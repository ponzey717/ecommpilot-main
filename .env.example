# Public canonical URLs
NEXT_PUBLIC_SITE_URL=https://ecommpilot.net
NEXT_PUBLIC_APP_URL=https://app.ecommpilot.net

# Server-side base URL for the allowlisted public catalog API.
# Production: https://app.ecommpilot.net
ECOMMPILOT_API_BASE_URL=

# Comma-separated HTTPS hostnames allowed for approved public product media.
# Use hostnames only, no scheme/path. Rebuild after changing because Next image config is build-time.
# Example: media.ecommpilot.net,<approved-storage-host>
ECOMMPILOT_PUBLIC_IMAGE_HOSTS=media.ecommpilot.net

# Fail-closed SEO switch. Keep false on local/staging.
# Set true only on the approved production public deployment.
ECOMMPILOT_PUBLIC_INDEXING_ENABLED=false

# Search Console verification (optional until production verification)
GOOGLE_SITE_VERIFICATION=

# Analytics (optional until provider is approved)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
